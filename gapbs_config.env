# Defaults for run_gapbs_perf.sh — Kronecker BFS + IMC CAS sampling
#
# Tuning goal: large DRAM working set + direction-optimizing BFS so the trace
# shows recurring high/low memory-bandwidth phases (per-level TD/BU steps).

# --- IMC sampler ---
INTERVAL_US=10
RESULTS_DIR=results

# --- BFS graph (synthetic Kronecker only; do not use -f twitter/web here) ---
# Sweet spot (your tuning): g=23, alpha=28, beta=4
# Turbo preset (--turbo): g=22, alpha=34, beta=2, max_bu=1, 144 threads
BFS_SCALE=23
BFS_DEGREE=16
BFS_TRIALS=64

# Direction-optimizing thresholds (see DOBFS in src/bfs.cc):
#   alpha — switch to bottom-up when frontier is large (higher => later)
#   beta  — stay in bottom-up while frontier grows (lower => exit BU loop sooner)
#   max_bu — cap bottom-up iterations per epoch (1 = one full-graph sweep then back to TD)
BFS_ALPHA=28
BFS_BETA=4
BFS_MAX_BU=0

# Turbo overrides (applied by: sudo ./run_gapbs_perf.sh --turbo)
TURBO_SCALE=22
TURBO_ALPHA=34
TURBO_BETA=2
TURBO_MAX_BU=1
TURBO_THREADS=144
TURBO_NUMA_CMD="numactl -m0,1 -C 0-143"

# --- OpenMP / NUMA (one socket on this 2x36-core host) ---
OMP_NUM_THREADS=72
OMP_PROC_BIND=close
OMP_PLACES=cores
# Pin to socket 0 CPUs and memory; drop or change if your topology differs.
NUMA_CMD="numactl --cpunodebind=0 --membind=0"

# Extra flags passed to ./bfs (e.g. -l for per-step timing on stderr)
BFS_EXTRA_ARGS=""

# Use pthread kernels instead of OpenMP: pass --pthread to run_gapbs_perf.sh /
# run_gapbs_pr_perf.sh (builds bfs_pthread / pr_pthread via Makefile.pthread).

# --- PageRank graph (for run_gapbs_pr_perf.sh; same Kronecker defaults as BFS) ---
PR_SCALE=23
PR_DEGREE=16
PR_TRIALS=64
PR_TOLERANCE=1e-4
PR_MAX_ITERS=20

# Extra flags passed to ./pr (e.g. -l for per-iteration timing on stderr)
PR_EXTRA_ARGS=""
